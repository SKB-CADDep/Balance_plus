# Same-origin: Nginx frontend проксирует /api/ к внутреннему backend.
VITE_API_URL=
PROJECT_NAME=WSAPropertiesCalculator
BACKEND_CORS_ORIGINS=http://localhost:5252
API_V1_STR=/api/v1

POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

ENVIRONMENT=development

# Для Docker Compose REDIS_HOST — имя сервиса. В Kubernetes укажите имя Redis Service.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0

# Не задавайте REDIS_URL, если используете переменные выше. Если он задан,
# то имеет приоритет и должен уже содержать пароль, порт и номер базы.
# REDIS_URL=redis://:change-me@redis:6379/0
