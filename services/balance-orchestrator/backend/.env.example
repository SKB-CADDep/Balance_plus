GITLAB_URL=https://git.utz.local
# OAuth is the default. Use legacy only temporarily and then provide the old PAT.
GITLAB_AUTH_MODE=oauth
GITLAB_PRIVATE_TOKEN=
GITLAB_PROJECT_ID=41
# Keep TLS verification enabled; install the factory CA in the container trust store.
GITLAB_SSL_VERIFY=true
GITLAB_TIMEOUT=10

# Authentication Service (reachable through the shared Docker network)
AUTH_SERVICE_URL=http://authentication-service:8000
AUTH_SERVICE_TIMEOUT=5
AUTH_SERVICE_CLIENT_SECRET=
ALLOWED_ORIGINS=http://localhost:3000
